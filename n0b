#!/usr/bin/env bash
echo `# <#` >/dev/null

set -euo pipefail

# A symlink onto PATH (~/.local/bin/n0b -> repo) must resolve to the repo,
# not to the symlink's own directory. readlink without -f, resolved in a
# loop: macOS ships bash 3.2 and BSD readlink, and both handle this form.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$DIR/$SELF" ;; esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
exec python3 "$SCRIPT_DIR/apps/n0b/n0b.py" "$@"
#> > $null

$ScriptPath = $PSCommandPath
if (-not $ScriptPath) {
    $ScriptPath = $MyInvocation.MyCommand.Path
}
if (-not $ScriptPath) {
    $ScriptPath = Join-Path (Get-Location) "n0b"
}

$ScriptDir = Split-Path -Parent $ScriptPath
$N0bPath = Join-Path $ScriptDir "apps/n0b/n0b.py"

$Python = Get-Command python3 -ErrorAction SilentlyContinue
if ($Python) {
    & $Python.Source $N0bPath @args
    exit $LASTEXITCODE
}

$Python = Get-Command python -ErrorAction SilentlyContinue
if ($Python) {
    & $Python.Source $N0bPath @args
    exit $LASTEXITCODE
}

$Python = Get-Command py -ErrorAction SilentlyContinue
if ($Python) {
    & $Python.Source -3 $N0bPath @args
    exit $LASTEXITCODE
}

Write-Error "Could not find python3, python, or py on PATH."
exit 127
