#!/usr/bin/env bash
echo `# <#` >/dev/null

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$SCRIPT_DIR/apps/b3t"
exec python3 "$SCRIPT_DIR/lib/venv_exec.py" b3t "$APP_DIR/__main__.py" "$@"
#> > $null

$ScriptPath = $PSCommandPath
if (-not $ScriptPath) { $ScriptPath = $MyInvocation.MyCommand.Path }
if (-not $ScriptPath) { $ScriptPath = Join-Path (Get-Location) "b3t" }

$ScriptDir = Split-Path -Parent $ScriptPath
$AppDir = Join-Path $ScriptDir "apps/b3t"
$B3tPath = Join-Path $AppDir "__main__.py"
$Runner = Join-Path $ScriptDir "lib/venv_exec.py"

$Python = Get-Command python3 -ErrorAction SilentlyContinue
if ($Python) { & $Python.Source $Runner b3t $B3tPath @args; exit $LASTEXITCODE }
$Python = Get-Command python -ErrorAction SilentlyContinue
if ($Python) { & $Python.Source $Runner b3t $B3tPath @args; exit $LASTEXITCODE }
$Python = Get-Command py -ErrorAction SilentlyContinue
if ($Python) { & $Python.Source -3 $Runner b3t $B3tPath @args; exit $LASTEXITCODE }

Write-Error "Could not find python3, python, or py on PATH."
exit 127
